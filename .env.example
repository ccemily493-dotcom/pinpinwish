# Supabase - get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Pinterest OAuth - get from https://developers.pinterest.com/apps/
PINTEREST_CLIENT_ID=your-pinterest-client-id
PINTEREST_CLIENT_SECRET=your-pinterest-client-secret
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback

# OAuth token encryption - generate with: openssl rand -hex 32
# IMPORTANT: Encryption and decryption of OAuth tokens occurs ONLY on the server.
# Never expose this key to the client or include it in NEXT_PUBLIC_ variables.
OAUTH_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
